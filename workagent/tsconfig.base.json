{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "declaration": false,
    "sourceMap": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@workagent/contracts": ["packages/contracts/src/index.ts"],
      "@workagent/db": ["packages/db/src/index.ts"],
      "@workagent/core": ["packages/core/src/index.ts"],
      "@workagent/ui": ["packages/ui/src/index.tsx"],
      "@workagent/config": ["packages/config/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", "data"]
}
