{
  "name": "workagent",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @workagent/api dev",
    "dev:worker": "pnpm --filter @workagent/worker dev",
    "dev:channel": "pnpm --filter @workagent/channel dev",
    "build": "pnpm typecheck && pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "node scripts/check-boundaries.mjs && pnpm -r test",
    "db:migrate": "pnpm --filter @workagent/db migrate",
    "db:seed": "pnpm --filter @workagent/db seed",
    "format": "prettier --write .",
    "dev:console": "pnpm --filter @workagent/console dev",
    "dev:user-portal": "pnpm --filter @workagent/user-portal dev",
    "production:preflight": "tsx scripts/production-preflight.mts",
    "test:browser": "playwright test",
    "audit:security": "pnpm audit --audit-level=high",
    "production:provision": "tsx scripts/provision.mts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "tsx": "^4.19.2"
  }
}
