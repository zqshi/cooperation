# Core
NODE_ENV=development
DATABASE_URL=postgres://workagent:workagent@localhost:5432/workagent
JWT_SECRET=change-me-jwt-secret
ENCRYPTION_KEY=change-me-32-byte-encryption-key!!
API_PORT=4100
API_URL=http://localhost:4100
CONSOLE_ORIGIN=http://localhost:5173
USER_PORTAL_ORIGIN=http://localhost:5174
CHANNEL_PORT=4101

# Model gateway (OpenAI compatible / LiteLLM). MODEL_API_KEY is required for execution; mock is test-only.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=
MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Storage: local | s3
STORAGE_DRIVER=local
ARTIFACT_DIR=./data/artifacts

# Seed admin
SEED_ADMIN_EMAIL=admin@workagent.local
SEED_ADMIN_PASSWORD=admin12345
SEED_ORG_NAME=WorkAgent Demo

# Feishu (optional)
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
FEISHU_BOT_NAME=WorkAgent

# DingTalk (optional)
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_ROBOT_CODE=


# Production: generate distinct random 48+ character secrets; no SEED_* or mock.
# Set public origins and MODEL_BASE_URL to HTTPS; MODEL_API_KEY is mandatory.
# Trust only actual reverse-proxy CIDRs; empty means untrusted.
TRUSTED_PROXY=
TOOL_ALLOWED_HOSTS=
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
# Production private channel hop: INTERNAL_API_URL=http://api:4100
